// ============================================================
// PATIENT CLASS
// ============================================================

class Patient {
private:
    int patientId;
    string name;
    int age;
    string condition;

public:

    // Default constructor
    Patient()
        : patientId(0), name("Unknown"),
          age(0), condition("Unknown") {}

    // Parameterized constructor
    Patient(int id, string n, int a, string c)
        : patientId(id), name(n),
          age(a), condition(c) {}

    // Copy constructor
    Patient(const Patient& p)
        : patientId(p.patientId),
          name(p.name),
          age(p.age),
          condition(p.condition) {}

    int getId() const {
        return patientId;
    }

    string getName() const {
        return name;
    }

    void display() const {
        cout << left
             << setw(10) << patientId
             << setw(20) << name
             << setw(8) << age
             << setw(25) << condition
             << endl;
    }
};


// ============================================================
// ABSTRACT BASE CLASS
// RESOURCE
// ============================================================

class Resource {
protected:
    int resourceId;
    string resourceName;
    bool available;

    static int totalResources;

public:

    Resource()
        : resourceId(0),
          resourceName("Unknown"),
          available(true) {
        totalResources++;
    }

    Resource(int id, string name)
        : resourceId(id),
          resourceName(name),
          available(true) {
        totalResources++;
    }

    virtual ~Resource() {
        totalResources--;
    }

    int getId() const {
        return resourceId;
    }

    bool isAvailable() const {
        return available;
    }

    void setAvailable(bool status) {
        available = status;
    }

    virtual void display() const = 0;

    virtual string getType() const = 0;

    virtual int getCapacity() const = 0;

    static int getTotalResources() {
        return totalResources;
    }
};

int Resource::totalResources = 0;


// ============================================================
// AMBULANCE
// ============================================================

class Ambulance : public Resource {
private:
    string ambulanceType;
    int patientCapacity;

public:

    Ambulance()
